# MongoDB service for LogIt
# 
# Installation:
#   1. Copy to /etc/systemd/system/logit-mongodb.service
#   2. Update paths below to match your deployment
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable logit-mongodb
#   5. sudo systemctl start logit-mongodb

[Unit]
Description=MongoDB for LogIt
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# Paths for ubuntu user deployment
WorkingDirectory=/home/ubuntu/LogIt
ExecStart=/home/ubuntu/mongodb_bin/bin/mongod --config /home/ubuntu/LogIt/mongod.conf

Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

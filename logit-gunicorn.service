[Unit]
Description=Gunicorn for LogIt Flask app
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/LogIt
Environment="PATH=/home/ubuntu/venv/bin"
ExecStart=/home/ubuntu/venv/bin/gunicorn --workers 3 --bind unix:/home/ubuntu/LogIt/logit.sock run:app
Restart=always

[Install]
WantedBy=multi-user.target
